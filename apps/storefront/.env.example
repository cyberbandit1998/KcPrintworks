# Copy to .env.local for local development. Never commit real values.

# development | staging | production. Only "production" is indexable by search engines.
SITE_ENV=development

# Canonical public origin of this deployment (used for metadata, sitemap, JSON-LD).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# fixtures = built-in placeholder catalog (Step 1). woo = WooCommerce via kcpw-core (Step 2, not implemented).
CATALOG_SOURCE=fixtures
