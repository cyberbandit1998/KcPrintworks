# Copy to .env on the VPS (/opt/kcprintworks-nextjs/.env), then:  chmod 600 .env
# Never commit a real .env and never paste its contents into a chat. The image holds no secrets; the WooCommerce
# key below lives only in this file on the server.

# The image to run. Always an explicit tag from the "Publish Docker image" workflow summary, e.g. sha-1a2b3c4.
# deploy.sh edits this line for you.
IMAGE_TAG=

# GitHub user or organization that owns the repository (lowercase).
GHCR_OWNER=cyberbandit1998

# Labels only; the image decides whether it is noindex. Keep "staging" until the owner approves going live.
SITE_ENV=staging
NEXT_PUBLIC_SITE_URL=https://staging.example.com

# ---- Product catalog ---------------------------------------------------------------------------------------------
# fixtures = placeholder products (works with nothing else set).  woo = the real WooCommerce catalog (read-only).
CATALOG_SOURCE=fixtures

# Only used when CATALOG_SOURCE=woo.
# The store address: https only. This is the site that runs WooCommerce (kcprintworks.com today, shop.kcprintworks.com later).
WC_BASE_URL=
# A WooCommerce REST API key with *Read* permission only (WooCommerce > Settings > Advanced > REST API > Add key,
# Permissions: Read). You create it; see docs/DEPLOYMENT-VPS.md section 9. Paste the values here with a text editor.
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=

# How often, in seconds, the storefront re-reads the catalog in the background (minimum 5, default 120).
CATALOG_REVALIDATE_SECONDS=120
# Signs "WooCommerce changed, refresh now" requests (POST /api/revalidate/). At least 16 random characters, for example
# the output of:  openssl rand -hex 24      Leave empty to turn the endpoint off (the background refresh still works).
REVALIDATE_SECRET=

# ---- Checkout (Step 3) -------------------------------------------------------------------------------------------
# OFF by default. Turn it on only on STAGING, after the kcpw-core plugin is installed on the shop site and Stripe is in
# TEST mode there (docs/CHECKOUT-STAGING-CHECKLIST.md). It can never be on in a production image.
CHECKOUT_ENABLED=false
# The WordPress/WooCommerce site that runs the kcpw-core plugin (https). Leave both empty to use WC_BASE_URL (the same site).
# KCPW_SHOP_URL is accepted as another name for KCPW_API_URL; if both are set, KCPW_API_URL wins.
KCPW_API_URL=
KCPW_SHOP_URL=
# 32+ random characters (openssl rand -hex 32). The SAME value goes in that site's wp-config.php as KCPW_HANDOFF_SECRET.
KCPW_HANDOFF_SECRET=

# ---- Free-shipping progress bar in the cart ------------------------------------------------------------------------
# DISPLAY ONLY: WooCommerce applies its own shipping rules at checkout and stays the only source of the shipping charge. This
# number must match the minimum order amount of the Free Shipping method in WooCommerce (docs/FREE-SHIPPING.md).
# Dollars, e.g. 40 or 40.00. Empty = the default, 40.00. "off" hides the bar. Anything else also hides it (and the server log says why).
FREE_SHIPPING_THRESHOLD=
# true only if that WooCommerce method has "Apply minimum order rule before coupon discount" ticked. Default false (discounts count).
FREE_SHIPPING_BEFORE_DISCOUNTS=false

# ---- Header, categories, blog, pages, and reviews -------------------------------------------------------------------
# All optional. Leave empty to use the defaults. docs/WORDPRESS-CONTENT-AND-REVIEWS.md explains each one.

# The header's "Game Cases" and "Personalized Gifts" links point at WooCommerce categories. A category slug or a numeric id.
# Defaults: game-cases and personalized-gifts. If the category does not exist the link is left out (nothing is guessed or created);
# /api/catalog-status/ shows what each link resolved to.
NAV_GAME_CASES=
NAV_PERSONALIZED_GIFTS=
# Category slugs kept out of browsing, comma separated. Default: uncategorized,new-arrivals (New Arrivals is built from publication dates, not the category).
HIDDEN_CATEGORY_SLUGS=

# The blog, Our Story, and Contact are read from WordPress (published posts and pages are public; no key is used). The site address
# defaults to WC_BASE_URL. The slugs are the last part of the WordPress page addresses.
WP_BASE_URL=
OUR_STORY_SLUG=
CONTACT_PAGE_SLUG=
# Posts per page on /blog/ (3 to 24, default 9).
BLOG_PER_PAGE=

# The lowest star rating the home page's Customer Reviews section shows (1 to 5, default 1 = every approved review).
HOME_REVIEWS_MIN_RATING=
# Let shoppers write reviews. OFF by default. Needs the kcpw-core plugin 0.2.0 or newer on the shop (docs/REVIEWS-STAGING-CHECKLIST.md),
# and the shop address and KCPW_HANDOFF_SECRET above. Every review is saved as PENDING; nothing is published until a person approves it.
REVIEWS_SUBMIT_ENABLED=false
# Reviews one visitor may send, and all visitors together, per ten minutes (defaults 3 and 60).
REVIEWS_RATE_LIMIT=
REVIEWS_RATE_LIMIT_ALL=
