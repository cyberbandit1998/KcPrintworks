# The PRODUCTION instance: copy this to /opt/kcprintworks-production/.env on the VPS, then:  chmod 600 .env
# It runs beside staging (/opt/kcprintworks-nextjs) and shares nothing with it but the Docker "proxy" network and the shop.
# Never commit a real .env and never paste its contents into a chat. The image holds no secrets.
# Read docs/CHECKOUT-PRODUCTION.md first: it lists what must be true on the shop BEFORE CHECKOUT_ENABLED is turned on here.

# ---- Which instance this is (read by deploy.sh and docker compose; do not change) ----------------------------------------
DEPLOY_KIND=production
COMPOSE_FILE=docker-compose.production.yml
COMPOSE_PROJECT_NAME=kcprintworks-production
# Nginx Proxy Manager forwards kcprintworks.com to THIS name, port 3000. It is not the staging container's name.
CONTAINER_NAME=kcprintworks-production

# The image to run: always an explicit production tag from the "Publish Docker image" run, ending in -production, e.g. sha-1a2b3c4-production.
# deploy.sh edits this line for you.
IMAGE_TAG=

# GitHub user or organization that owns the repository (lowercase).
GHCR_OWNER=cyberbandit1998

# Labels only; the production image was built as production with https://kcprintworks.com baked in, and nothing here can change that.
SITE_ENV=production
NEXT_PUBLIC_SITE_URL=https://kcprintworks.com

# ---- Product catalog (required: checkout refuses to start from sample data) -------------------------------------------------
CATALOG_SOURCE=woo
WC_BASE_URL=https://shop.kcprintworks.com
# A WooCommerce REST API key with *Read* permission only. You create it (docs/DEPLOYMENT-VPS.md section 9) and paste it here with a text editor.
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=
CATALOG_REVALIDATE_SECONDS=120
REVALIDATE_SECRET=

# ---- Checkout -----------------------------------------------------------------------------------------------------------------
# OFF by default. Leave it false until every step in docs/CHECKOUT-PRODUCTION.md is done; real cards are charged once Stripe is live.
CHECKOUT_ENABLED=false
# The shop that runs the kcpw-core plugin: https, and not the storefront's own host. Leave both empty to use WC_BASE_URL above.
KCPW_API_URL=https://shop.kcprintworks.com
KCPW_SHOP_URL=
# 32+ random characters (openssl rand -hex 32). The shop has ONE KCPW_HANDOFF_SECRET (wp-config.php), so staging and production
# use the same value; keep each .env chmod 600.
KCPW_HANDOFF_SECRET=

# ---- Same optional settings as staging (see .env.example for what each does) ---------------------------------------------------
FREE_SHIPPING_THRESHOLD=
FREE_SHIPPING_BEFORE_DISCOUNTS=false
NAV_GAME_CASES=
NAV_PERSONALIZED_GIFTS=
HIDDEN_CATEGORY_SLUGS=
WP_BASE_URL=
OUR_STORY_SLUG=
CONTACT_PAGE_SLUG=
BLOG_PER_PAGE=
HOME_REVIEWS_MIN_RATING=
REVIEWS_SUBMIT_ENABLED=false
REVIEWS_RATE_LIMIT=
REVIEWS_RATE_LIMIT_ALL=
